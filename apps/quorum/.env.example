# Required in production (32+ random characters). Signs attendee + local organizer cookies.
QUORUM_SESSION_SECRET=
# Local JSON directory when DATABASE_URL is unset.
QUORUM_DATA_DIR=
# --- Qloo (server-side only; demo mode makes zero calls) ---
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QUORUM_ENABLE_LIVE=false
# --- Neon hosted storage (Vercel) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# --- Optional LLM narration over real scores (QUORUM_ENABLE_LLM=true) ---
QUORUM_ENABLE_LLM=false
QUORUM_LLM_PROVIDER=openai
QUORUM_LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
